{
  "description": "gitfold: worktrees as workspaces where the repository is mounted (a git worktree where it isn't used with gitfold); inbox messages into the session (nothing outside a workspace); reads by Read and simple Bash viewers recorded in workspaces tracking reads; an agent's presence in its workspace, and its branch taking its parent's new commits at each turn start. bin/gitfold runs gitfold: one on PATH, or the release, downloaded.",
  "hooks": {
    "WorktreeCreate": [{ "hooks": [{ "type": "command",
      "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gitfold\" branch --claude-hook worktree-create" }] }],
    "WorktreeRemove": [{ "hooks": [{ "type": "command",
      "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gitfold\" remove --claude-hook worktree-remove" }] }],
    "SessionStart": [{ "hooks": [{ "type": "command",
      "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gitfold\" parent --claude-hook session-start" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command",
      "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gitfold\" parent --claude-hook session-end" }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command",
      "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gitfold\" parent --claude-hook subagent-stop" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command",
      "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gitfold\" parent --claude-hook user-prompt-submit" }, { "type": "command",
      "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gitfold\" inbox --claude-hook user-prompt-submit" }] }],
    "PreToolUse": [{ "matcher": "Read|Bash", "hooks": [{ "type": "command",
      "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gitfold\" track-reads --claude-hook pre-tool-use",
      "async": true }] }],
    "PostToolUse": [{ "matcher": "*", "hooks": [{ "type": "command",
      "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gitfold\" inbox --claude-hook post-tool-use" }] }],
    "Stop": [{ "hooks": [{ "type": "command",
      "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gitfold\" inbox --claude-hook rewake",
      "async": true, "asyncRewake": true, "timeout": 86400 }] }]
  }
}
