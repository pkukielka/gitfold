#!/bin/sh
# gitfold's guard, second line: refuses to push a commit that brings another
# layer's uncommitted lines, then runs the user's own pre-push.
. "${0%/*}/gitfold-lib.sh"
gitfold_updates=$(cat)
printf '%s\n' "$gitfold_updates" | gitfold_guard pre-push || exit 1
printf '%s' "$gitfold_updates${gitfold_updates:+
}" | gitfold_user_hook pre-push "$@"
