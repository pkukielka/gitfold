#!/bin/sh
# gitfold for the Claude Code plugin: its hooks run this, and Claude Code puts
# this directory on its sessions' PATH. It runs $GITFOLD_BIN, else a gitfold
# on PATH, else the release of this plugin's version (Cargo.toml), downloaded
# once to ~/.local/share/gitfold/bin from GitHub ($GITFOLD_RELEASE_URL: a
# mirror, or tests), checked against SHA256SUMS and tried once. Without one,
# `without` below. Every hook runs it: no subprocess on the way to gitfold.

set -u
case $0 in */*) here=${0%/*} ;; *) here=. ;; esac

# The first gitfold on PATH other than this one, in $bin.
on_path() {
    IFS=:
    set -f
    for dir in $PATH; do
        # -ef: not POSIX, but in dash, bash and busybox.
        # shellcheck disable=SC3013
        if [ -n "$dir" ] && [ -x "$dir/gitfold" ] && ! [ "$dir/gitfold" -ef "$0" ]; then
            bin=$dir/gitfold
            return 0
        fi
    done
    return 1
}

# The release binary in $bin, downloaded if needed. A failed download is
# retried after a day, not on every hook.
release() {
    IFS=' '
    version=
    while read -r key eq value; do
        if [ "$key" = version ] && [ "$eq" = = ]; then
            version=${value#\"}
            version=${version%\"}
            break
        fi
    done <"$here/../Cargo.toml"
    data=${XDG_DATA_HOME:-$HOME/.local/share}/gitfold/bin
    for arch in x86_64 aarch64; do
        bin=$data/gitfold-$version-$arch
        [ -x "$bin" ] && return 0
    done
    case $(uname -sm) in
        "Linux x86_64") arch=x86_64 ;;
        "Linux aarch64" | "Linux arm64") arch=aarch64 ;;
        *) return 1 ;;
    esac
    bin=$data/gitfold-$version-$arch
    failed=$data/.failed-$version-$arch
    if [ -f "$failed" ] && [ -z "$(find "$failed" -mmin +1440)" ]; then
        return 1
    fi
    mkdir -p "$data" || return 1
    if fetch >"$failed" 2>&1; then
        rm -f "$failed"
        return 0
    fi
    echo "gitfold: no release binary ($(tail -n 1 "$failed")); retried after a day" >&2
    return 1
}

# Downloads release $version's binary for $arch as $bin, checked.
fetch() {
    base=${GITFOLD_RELEASE_URL:-https://github.com/pkukielka/gitfold/releases/download}/v$version
    name=gitfold-$arch-linux
    tmp=$(mktemp "$data/.download-XXXXXX") || return 1
    get "$base/$name" >"$tmp" && sums=$(get "$base/SHA256SUMS") ||
        fail "downloading $base/$name failed" || return 1
    want=$(echo "$sums" | awk -v n="$name" '$2 == n || $2 == "*" n { print $1 }')
    [ -n "$want" ] && [ "$want" = "$(sha256sum "$tmp" | cut -d ' ' -f 1)" ] ||
        fail "$name doesn't match the release's SHA256SUMS" || return 1
    chmod +x "$tmp"
    "$tmp" --version >/dev/null 2>&1 || fail "the release binary doesn't run on this system" || return 1
    mv -f "$tmp" "$bin"
}

fail() {
    rm -f "$tmp"
    echo "$1"
    return 1
}

get() {
    if command -v curl >/dev/null; then
        curl -fsSL "$1"
    elif command -v wget >/dev/null; then
        wget -qO- "$1"
    else
        echo "neither curl nor wget" >&2
        return 1
    fi
}

# The string $1 holds in the JSON on stdin (no escapes: enough for the names
# and paths Claude Code passes, else empty).
field() {
    sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"\\]*\)".*/\1/p' | head -n 1
}

# Without gitfold, the hooks do what Claude Code does without them, as
# src/cli/claude.rs does where gitfold isn't used (keep the two alike): the
# inbox hooks nothing, the worktree hooks git worktrees; but in a repository
# used with gitfold (state in <git common dir>/gitfold), creating one fails.
without() {
    case "$*" in
        "inbox --claude-hook "*) exit 0 ;;
        "branch --claude-hook worktree-create")
            input=$(cat)
            name=$(echo "$input" | field name)
            cwd=$(echo "$input" | field cwd)
            if [ -z "$name" ] || [ -z "$cwd" ]; then
                echo "gitfold: can't read the hook's input" >&2
                exit 1
            fi
            if [ -d "$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir)/gitfold" ]; then
                echo "gitfold: this repository is used with gitfold, but gitfold can't run here" >&2
                exit 1
            fi
            top=$(git -C "$cwd" rev-parse --show-toplevel) || exit 1
            path=$top/.claude/worktrees/$name
            if [ ! -e "$path/.git" ]; then
                if git -C "$top" rev-parse -q --verify "refs/heads/worktree-$name" >/dev/null; then
                    git -C "$top" worktree add "$path" "worktree-$name" >&2 || exit 1
                else
                    git -C "$top" worktree add -b "worktree-$name" "$path" >&2 || exit 1
                fi
            fi
            echo "$path"
            exit 0 ;;
        "remove --claude-hook worktree-remove")
            path=$(field worktree_path)
            cd / || exit 1
            [ -e "$path" ] || exit 0
            common=$(git -C "$path" rev-parse --path-format=absolute --git-common-dir) || exit 1
            exec git --git-dir="$common" worktree remove --force "$path" ;;
    esac
    echo "gitfold: not found, and no release binary for this system; see https://github.com/pkukielka/gitfold#quick-start" >&2
    exit 1
}

if [ -n "${GITFOLD_BIN:-}" ]; then
    exec "$GITFOLD_BIN" "$@"
fi
if on_path || release; then
    IFS=' '
    exec "$bin" "$@"
fi
IFS=' '
without "$@"
